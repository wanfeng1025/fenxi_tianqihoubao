{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "hdfsreader",
                    "parameter": {
                        "path": "/user/hive/warehouse/weather_db.db/city_max_mintemp",
                        "defaultFS": "hdfs://YOUR_HADOOP_HOST:9000",
                        "fileType": "text",
                        "fieldDelimiter": ",",
                        "encoding": "UTF-8",
                        "nullFormat": "\\N",
                        "column": [
                            {
                                "index": 0,
                                "type": "string"
                            },
                            {
                                "index": 1,
                                "type": "string"
                            },
                            {
                                "index": 2,
                                "type": "string"
                            }
                        ]
                    }
                },
                "writer": {
                    "name": "mysqlwriter",
                    "parameter": {
                        "username": "YOUR_MYSQL_USER",
                        "password": "YOUR_MYSQL_PASSWORD",
                        "writeMode": "insert",
                        "column": [
                            "city_name",
                            "max_temperature",
                            "min_temperature"
                        ],
                        "connection": [
                            {
                                "jdbcUrl": "jdbc:mysql://YOUR_MYSQL_HOST:3306/weather_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai",
                                "table": [
                                    "city_max_mintemp"
                                ]
                            }
                        ],
                        "preSql": [
                            "TRUNCATE TABLE city_max_mintemp"
                        ],
                        "batchSize": 1024
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": 1
            }
        }
    }
}
