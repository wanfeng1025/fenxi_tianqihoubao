# Copy to .env or export these variables before running src/main.py.
WEATHER_DB_HOST=your-mysql-host
WEATHER_DB_PORT=3306
WEATHER_DB_USER=your-mysql-user
WEATHER_DB_PASSWORD=your-mysql-password
WEATHER_DB_NAME=weather_db
WEATHER_MAX_WORKERS=4
WEATHER_REQUEST_DELAY=1.0
WEATHER_REQUEST_TIMEOUT=25
WEATHER_MAX_RETRIES=3
WEATHER_INITIAL_RETRY_DELAY=5
